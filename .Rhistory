# ------------------------------------------------------------
# Panel A
# ------------------------------------------------------------
synthesis_plot <- synthesis_plot +
guides(
shape = guide_legend(
title.position = "top",
title.hjust = 0.5,
nrow = 1,
order = 1,
override.aes = list(
size = 4,
fill = "lightgrey"
)
),
fill = guide_colourbar(
title.position = "top",
title.hjust = 0.5,
barwidth = grid::unit(8, "cm"),
barheight = grid::unit(0.45, "cm"),
direction = "horizontal",
order = 2
)
) +
theme(
legend.position = "bottom",
legend.box = "vertical",
legend.box.just = "center",
plot.margin = margin(10, 10, 5, 10)
)
# ------------------------------------------------------------
# Panel B
# ------------------------------------------------------------
comparison_plot <- ggplot(
fjord_points,
aes(
x = Durable_AT,
y = Model_AT,
shape = Fjord
)
) +
geom_abline(
slope = 1,
intercept = 0,
linetype = "dashed",
colour = "grey55",
linewidth = 0.5
) +
geom_point(
size = 4.3,
fill = "lightgrey",
colour = "black",
stroke = 1.3
) +
scale_shape_manual(
values = c(
"Byfjord" = 21,
"Hvalfjörður" = 24,
"Igaliku Fjord" = 22
)
) +
coord_equal(
xlim = c(-0.1, 11),
ylim = c(0, 11),
expand = FALSE
) +
scale_x_continuous(
breaks = c(-0.1, 0, 2.5, 5, 7.5, 10)
) +
scale_y_continuous(
breaks = c(0, 2.5, 5, 7.5, 10)
) +
labs(
y = expression(
"Net benthic " * A[T] ~ "flux" ~
"(mmol m"^{-2} ~ d^{-1} * ")"
),
x = expression(
"Net " * A[T] ~ "input to the ocean" ~
"(mmol m"^{-2} ~ d^{-1} * ")"
)
) +
theme_classic(base_size = 12) +
theme(
legend.position = "none",
axis.text = element_text(colour = "black"),
plot.margin = margin(10, 10, 5, 10)
)
comparison_plot
