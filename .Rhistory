get_PIC_profiles <- function(out, max_depth_cm = 25) {
depth_cm <- out$depth * 100
df <- tibble(
depth_cm = depth_cm,
CALC_diss = out$CALCdiss,
ARAG_diss = out$ARAGdiss,
CALC_prod = out$CALCprod,
omegaCa = out$omegaCa,
omegaAr = out$omegaAr,
pH = out$pH,
TotalCALC = out$y[,"CALC"],
TotalARAG = out$y[,"ARAG"]
)
# Add aragonite production if present
if ("ARAGprod" %in% names(out)) {
df$ARAG_prod <- out$ARAGprod
} else {
df$ARAG_prod <- 0
}
df %>%
filter(depth_cm <= max_depth_cm)
}
PIC_profiles_HV <- get_PIC_profiles(
HVsim,
max_depth_cm = 25
)
PIC_process_long <- PIC_profiles_HV %>%
select(
depth_cm,
CALC_diss,
ARAG_diss,
CALC_prod,
ARAG_prod
) %>%
pivot_longer(
-depth_cm,
names_to = "Process",
values_to = "Rate"
)
ggplot(
PIC_process_long,
aes(
x = Rate,
y = depth_cm,
colour = Process
)
) +
geom_path(linewidth = 0.9) +
scale_y_reverse() +
labs(
x = "Reaction rate",
y = "Depth (cm)",
colour = NULL
) +
theme_classic(base_size = 13)
PIC_profiles_HV %>%
select(
depth_cm,
omegaCa,
omegaAr
) %>%
pivot_longer(
-depth_cm,
names_to = "Mineral",
values_to = "Omega"
) %>%
ggplot(
aes(
x = Omega,
y = depth_cm,
colour = Mineral
)
) +
geom_vline(
xintercept = 1,
linetype = "dashed",
colour = "grey50"
) +
geom_path(linewidth = 0.9) +
scale_y_reverse() +
labs(
x = expression(Omega),
y = "Depth (cm)",
colour = NULL
) +
theme_classic(base_size = 13)
ggplot(
PIC_profiles_HV,
aes(
x = pH,
y = depth_cm
)
) +
geom_path(linewidth = 0.9) +
scale_y_reverse() +
labs(
x = "pH",
y = "Depth (cm)"
) +
theme_classic(base_size = 13)
PIC_profiles_HV %>%
select(
depth_cm,
TotalCALC,
TotalARAG
) %>%
pivot_longer(
-depth_cm,
names_to = "Mineral",
values_to = "Amount"
) %>%
ggplot(
aes(
x = Amount,
y = depth_cm,
colour = Mineral
)
) +
geom_path(linewidth = 0.9) +
scale_y_reverse() +
labs(
x = "Solid carbonate",
y = "Depth (cm)",
colour = NULL
) +
theme_classic(base_size = 13)
get_PIC_budget <- function(out,
CALCflux = NULL,
ARAGflux = NULL) {
#------------------------------------------------------------
# Integrated fluxes
#------------------------------------------------------------
calcite_burial   <- out$CALCdeepflux
aragonite_burial <- out$ARAGdeepflux
calcite_diss   <- out$TotCALCdiss
aragonite_diss <- out$TotARAGdiss
calcite_prod <- out$TotCALCprod
aragonite_prod <- if ("TotARAGprod" %in% names(out))
out$TotARAGprod
else
0
#------------------------------------------------------------
# Budget table
#------------------------------------------------------------
tibble(
Mineral = c("Calcite", "Aragonite", "Total PIC"),
Input = c(
CALCflux,
ARAGflux,
CALCflux + ARAGflux
),
Dissolution = c(
calcite_diss,
aragonite_diss,
calcite_diss + aragonite_diss
),
Production = c(
calcite_prod,
aragonite_prod,
calcite_prod + aragonite_prod
),
Burial = c(
calcite_burial,
aragonite_burial,
calcite_burial + aragonite_burial
)
) %>%
mutate(
Net_reaction = Production - Dissolution,
Closure = Input +
Production -
Dissolution -
Burial,
Fraction_dissolved = Dissolution / Input,
Fraction_produced  = Production / Input,
Fraction_buried    = Burial / Input,
Percent_dissolved = 100 * Fraction_dissolved,
Percent_produced  = 100 * Fraction_produced,
Percent_buried    = 100 * Fraction_buried
)
}
PIC_budget_HV <- get_PIC_budget(HVsim,
CALCflux     = HVparms$CALCflux,
ARAGflux     = HVparms$ARAGflux)
PIC_budget_HV
