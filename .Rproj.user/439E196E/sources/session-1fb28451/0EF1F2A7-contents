# Helper functions for sensitivity analysis

The chunks below define a small set of reusable functions. Each sensitivity analysis
then only needs a vector of input values, the FEMSDIA parameter to alter, a display
name, and axis labels.

```{r sensitivity-functions}
# ------------------------------------------------------------------------------
# Shared plotting theme
# ------------------------------------------------------------------------------
plot_theme <- function(base_size = 13) {
  theme_classic(base_size = base_size) +
    theme(
      axis.line = element_line(colour = "black", linewidth = 0.6),
      axis.ticks = element_line(colour = "black", linewidth = 0.6),
      axis.text = element_text(colour = "black"),
      axis.text.x = element_text(angle = 45, hjust = 1),
      strip.background = element_blank(),
      strip.text = element_text(face = "bold"),
      legend.position = "right",
      panel.spacing = unit(1.2, "lines")
    )
}

# ------------------------------------------------------------------------------
# Run one full sensitivity set
# ------------------------------------------------------------------------------
run_sensitivity <- function(values,
                            parameter,
                            base_parms = baseParms,
                            value_name = parameter,
                            value_transform = identity,
                            rds_file = NULL,
                            dynamic_pH = TRUE,
                            overwrite = FALSE) {

  if (!is.null(rds_file) && file.exists(rds_file) && !overwrite) {
    cached_runs <- readRDS(rds_file)

    if (length(cached_runs) > 0 && isTRUE("value" %in% names(cached_runs[[1]]))) {
      return(cached_runs)
    }

    message("Ignoring stale cached runs in ", rds_file, " and rebuilding.")
  }

  model_values <- value_transform(values)

  runs <- purrr::map2(values, model_values, function(display_value, model_value) {
    parms_i <- base_parms
    parms_i[[parameter]] <- model_value

    message(
      "Running ", parameter, " = ", display_value,
      " | model value = ", signif(model_value, 4)
    )

    out_i <- FEMSDIA_run_steady(parms = parms_i, dynamicpH = dynamic_pH)

    list(
      value = display_value,
      model_value = model_value,
      parameter = parameter,
      value_name = value_name,
      parms = parms_i,
      output = out_i
    )
  })

  names(runs) <- paste0(parameter, "_", values)

  if (!is.null(rds_file)) {
    saveRDS(runs, file = rds_file)
  }

  runs
}

# ------------------------------------------------------------------------------
# Convert model output into plotting tables
# ------------------------------------------------------------------------------
profile_data <- function(runs, max_depth_cm = 25) {
  purrr::map_dfr(runs, function(run) {
    tibble(
      depthcm = run$output$depth * 100,
      DIC = run$output$y[, "DIC"] / 1000,
      ALK = run$output$y[, "ALK"] / 1000,
      TOC = run$output$OCpercent,
      value = run$value
    )
  }) %>%
    filter(depthcm <= max_depth_cm) %>%
    pivot_longer(
      cols = c(DIC, ALK, TOC),
      names_to = "variable",
      values_to = "profile_value"
    ) %>%
    mutate(
      variable = factor(
        variable,
        levels = c("DIC", "ALK", "TOC"),
        labels = c("DIC (mM)", "Alkalinity (mM)", "Organic Carbon (%)")
      )
    )
}

carbon_mineralisation_data <- function(runs) {
  purrr::map_dfr(runs, function(run) {
    bud <- FEMSDIA_get_budgetC(run$output)

    tibble(
      value = run$value,
      OxicMineralisation = bud$Rates[["OxicMineralisation"]],
      Denitrification = bud$Rates[["Denitrification"]],
      MnReduction = bud$Rates[["MnReduction"]],
      FeReduction = bud$Rates[["IronReduction"]],
      SulphateReduction = bud$Rates[["SulphateReduction"]],
      Methanogenesis = bud$Rates[["Methanogenesis"]]
    )
  }) %>%
    pivot_longer(
      cols = -value,
      names_to = "Process",
      values_to = "Rate"
    ) %>%
    mutate(
      Process = factor(
        Process,
        levels = rev(c(
          "OxicMineralisation",
          "Denitrification",
          "MnReduction",
          "FeReduction",
          "SulphateReduction",
          "Methanogenesis"
        ))
      )
    )
}

carbonate_budget_data <- function(runs) {
  purrr::map_dfr(runs, function(run) {
    out <- run$output

    tibble(
      value = run$value,
      CarbonateDissolution = out$TotCALCdiss,
      CarbonatePrecipitation = out$TotCALCprod,
      AragoniteDissolution = out$TotARAGdiss,
      CarbonateBurial = -out$CALCdeepflux,
      AragoniteBurial = -out$ARAGdeepflux,
      CarbonateNetDIC = out$TotCALCdiss - out$TotCALCprod,
      AragoniteNetDIC = out$TotARAGdiss
    )
  }) %>%
    pivot_longer(
      cols = -value,
      names_to = "Process",
      values_to = "Rate"
    )
}

alk_mineralisation_data <- function(runs) {
  purrr::map_dfr(runs, function(run) {
    out <- run$output

    tibble(
      value = run$value,
      Process = c(
        "Net ammonification",
        "Denitrification",
        "Net iron reduction",
        "Net sulfate reduction",
        "Net methanogenesis"
      ),
      JAlk = c(
        out$TotNH3prodMin - out$TotNitri1 - out$TotAnammox,
        0.8 * out$TotDenit,
        8 * out$TotFered - 2 * out$TotFeoxid - out$TotFeMnoxid,
        out$TotBSR - 2 * out$TotH2Soxid -
          2 * out$TotFeSoxid -
          4 * out$TotFeS2oxid +
          4 * out$TotH2SFeoxid +
          2 * out$TotH2SMnoxid,
        0
      )
    )
  })
}

alk_krumins_data <- function(runs) {
  purrr::map_dfr(runs, function(run) {
    out <- run$output

    net_ammonification <- out$TotNH3prodMin - out$TotNitri1 - out$TotAnammox
    net_fe_reduction <- 8 * out$TotFered - 2 * out$TotFeoxid - out$TotFeMnoxid
    net_sulfate_reduction <- out$TotBSR - 2 * out$TotH2Soxid -
      2 * out$TotFeSoxid - 4 * out$TotFeS2oxid +
      4 * out$TotH2SFeoxid + 2 * out$TotH2SMnoxid

    calcite_diss <- 2 * out$TotCALCdiss
    aragonite_diss <- 2 * out$TotARAGdiss
    alk_burial <- -2 * (out$CALCdeepflux + out$ARAGdeepflux)
    reduced_burial <- 2 * out$FeSdeepflux + 4 * out$FeS2deepflux
    sulfide_wc_oxid <- -2 * abs(out$H2Sflux)

    tibble(
      value = run$value,
      Process = c(
        "Net sulfate reduction",
        "Net ammonification",
        "Denitrification",
        "Net iron reduction",
        "Calcite dissolution",
        "Aragonite dissolution",
        "Alk burial",
        "Reduced S / Fe burial",
        "Sulfides oxidized in water column"
      ),
      JAlk = c(
        net_sulfate_reduction,
        net_ammonification,
        0.8 * out$TotDenit,
        net_fe_reduction,
        calcite_diss,
        aragonite_diss,
        abs(alk_burial),
        reduced_burial,
        abs(sulfide_wc_oxid)
      )
    )
  })
}

# ------------------------------------------------------------------------------
# Reusable plots
# ------------------------------------------------------------------------------
plot_profiles <- function(runs,
                          legend_title,
                          colour_breaks = NULL,
                          colour_labels = NULL,
                          colour_trans = "identity",
                          max_depth_cm = 25,
                          toc_log_scale = TRUE) {

  df <- profile_data(runs, max_depth_cm = max_depth_cm)

  toc_scale <- if (toc_log_scale) scale_x_log10(expand = c(0, 0.1)) else NULL

  ggplot(
    df,
    aes(
      x = profile_value,
      y = depthcm,
      group = interaction(value, variable),
      colour = value
    )
  ) +
    geom_path(linewidth = 1) +
    facet_wrap2(~variable, scales = "free_x") +
    facetted_pos_scales(x = list(NULL, NULL, toc_scale)) +
    scale_y_reverse(limits = c(max_depth_cm, 0), expand = c(0, 0)) +
    scale_colour_viridis_c(
      name = legend_title,
      option = "plasma",
      breaks = colour_breaks,
      labels = colour_labels,
      trans = colour_trans
    ) +
    labs(x = NULL, y = "Depth (cm)") +
    plot_theme()
}

plot_c_mineralisation <- function(runs, x_label) {
  df <- carbon_mineralisation_data(runs)

  ggplot(df, aes(x = factor(value), y = Rate, fill = Process)) +
    geom_col(width = 0.85, colour = "black", linewidth = 0.2) +
    scale_fill_viridis_d(option = "plasma", begin = 0, end = 1, alpha = 0.8) +
    labs(
      x = x_label,
      y = expression("Mineralisation rate (mmol C " * m^{-2} * d^{-1} * ")")
    ) +
    plot_theme()
}

plot_carbonate_budget <- function(runs, x_label) {
  df <- carbonate_budget_data(runs) %>%
    filter(Process %in% c(
      "CarbonateNetDIC",
      "AragoniteNetDIC",
      "CarbonateBurial",
      "AragoniteBurial"
    ))

  ggplot(df, aes(x = factor(value), y = Rate, fill = Process)) +
    geom_col(width = 0.85, colour = "black", linewidth = 0.2) +
    scale_fill_viridis_d(option = "plasma", begin = 0, end = 1, alpha = 0.8) +
    labs(
      x = x_label,
      y = expression("PIC dissolution or burial (mmol C " * m^{-2} * d^{-1} * ")")
    ) +
    plot_theme()
}

plot_alk_mineralisation <- function(runs, x_label) {
  df <- alk_mineralisation_data(runs)

  ggplot(df, aes(x = factor(value), y = JAlk, fill = Process)) +
    geom_col(width = 0.85, colour = "black", linewidth = 0.2) +
    scale_fill_viridis_d(option = "plasma", begin = 0, end = 1, alpha = 0.8) +
    labs(
      x = x_label,
      y = expression(J[Alk]~"(mmol eq m"^{-2}~d^{-1}*")"),
      fill = NULL
    ) +
    plot_theme()
}

plot_alk_krumins <- function(runs, x_label) {
  df <- alk_krumins_data(runs) %>%
    mutate(
      Bar = case_when(
        Process %in% c(
          "Net sulfate reduction",
          "Net ammonification",
          "Denitrification",
          "Net iron reduction",
          "Calcite dissolution",
          "Aragonite dissolution"
        ) ~ "JAlk",
        Process %in% c(
          "Alk burial",
          "Reduced S / Fe burial",
          "Sulfides oxidized in water column"
        ) ~ "JAlk*"
      )
    ) %>%
    filter(!is.na(Bar)) %>%
    mutate(
      Bar = factor(Bar, levels = c("JAlk", "JAlk*")),
      Process = factor(
        Process,
        levels = c(
          "Net sulfate reduction",
          "Net ammonification",
          "Denitrification",
          "Net iron reduction",
          "Calcite dissolution",
          "Aragonite dissolution",
          "Alk burial",
          "Reduced S / Fe burial",
          "Sulfides oxidized in water column"
        )
      ),
      value_factor = factor(value, levels = sort(unique(value))),
      x_base = as.numeric(value_factor),
      x_pos = ifelse(Bar == "JAlk", x_base - 0.17, x_base + 0.17)
    )

  ggplot(df, aes(x = x_pos, y = JAlk, fill = Process)) +
    geom_col(width = 0.32, colour = "black", linewidth = 0.2) +
    scale_x_continuous(
      breaks = unique(df$x_base),
      labels = levels(df$value_factor)
    ) +
    scale_fill_viridis_d(option = "plasma", begin = 0, end = 1, alpha = 0.8) +
    labs(
      x = x_label,
      y = expression("Alkalinity generation and fate (mmol eq " * m^{-2} * d^{-1} * ")"),
      fill = NULL
    ) +
    plot_theme()
}

plot_all_sensitivity_outputs <- function(runs,
                                         x_label,
                                         legend_title,
                                         colour_breaks = NULL,
                                         colour_labels = NULL,
                                         colour_trans = "identity") {
  list(
    profiles = plot_profiles(
      runs,
      legend_title = legend_title,
      colour_breaks = colour_breaks,
      colour_labels = colour_labels,
      colour_trans = colour_trans
    ),
    c_mineralisation = plot_c_mineralisation(runs, x_label),
    carbonate_budget = plot_carbonate_budget(runs, x_label),
    alk_mineralisation = plot_alk_mineralisation(runs, x_label),
    alk_krumins = plot_alk_krumins(runs, x_label)
  )
}
```

# The role of deposition

Investigating the effect of deposition on alkalinity dynamics is not straightforward,
as this encompasses several aspects. Deposition is the combination of mineral deposits
and organic matter. The scenarios below vary the main boundary conditions individually.

## Sediment advection rate

Measured advection rates in fjords globally range from 0.01 cm y-1 to 12 cm y-1
(Bianchi et al., 2020 - https://doi.org/10.1016/j.earscirev.2020.103145).

```{r advection-runs}
inputw_cm_yr <- c(0.01, 0.05, 0.1, 0.2, 0.4, 0.6, 0.8, 1, 1.5, 2, 3, 5, 10, 12)

runs_w <- run_sensitivity(
  values = inputw_cm_yr,
  parameter = "w",
  value_name = "w_cm_yr",
  value_transform = function(x) x / 100 / 365.25,
  rds_file = "FEMSDIA_w_sensitivity_runs.rds"
)

runs_w <- readRDS("FEMSDIA_w_sensitivity_runs.rds")

```

```{r advection-plots, fig.height = 3, fig.width = 8}
w_plots <- plot_all_sensitivity_outputs(
  runs_w,
  x_label = expression(w~"(cm yr"^{-1}*")"),
  legend_title = expression(w~"(cm yr"^{-1}*")"),
  colour_breaks = c(0.01, 0.1, 1, 10),
  colour_labels = as.character(c(0.01, 0.1, 1, 10)),
  colour_trans = "log10"
)

w_plots$profiles
w_plots$c_mineralisation
w_plots$carbonate_budget
w_plots$alk_mineralisation
w_plots$alk_krumins
```

## OM deposition flux - accumulation rate

The endpoints of the range of organic matter deposition values, 0.41 - 51.2 +- 4.3
mmol C m-2 d-1 are determined by Smith et al. (2015) on the low end and Walinsky
et al. (2009) on the high end.

```{r cflux-runs}
inputCmmol <- c(0.04, 0.1, 0.5, 1, 2, 5, 10, 15, 20, 25, 37.5, 50)

runs_Cflux <- run_sensitivity(
  values = inputCmmol,
  parameter = "Cflux",
  value_name = "Cflux_m2day",
  rds_file = "FEMSDIA_Cflux_sensitivity_runs.rds"
)
```

```{r cflux-plots, fig.height = 3, fig.width = 8}
cflux_plots <- plot_all_sensitivity_outputs(
